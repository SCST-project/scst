; SPDX-License-Identifier: GPL-2.0-only
; Each job owns one disjoint region. Rendered copies are kept in run artifacts.
[global]
filename=@DEVICE@
ioengine=io_uring
force_async=1
direct=@DIRECT@
size=@REGION@
allow_file_create=0
invalidate=1
end_fsync=1
verify=crc32c
verify_fatal=1
verify_state_save=0
verify_only=@VERIFY_ONLY@
randrepeat=1
exitall_on_error=1

[small]
rw=randwrite
bs=4k
iodepth=32
offset=0
randseed=101

[medium]
rw=randwrite
bs=64k
iodepth=16
offset=@OFFSET1@
randseed=202

[large]
rw=write
bs=128k
iodepth=1
offset=@OFFSET2@
randseed=303

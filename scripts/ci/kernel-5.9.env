# Linux 5.9 is the first release in which fork() gives the child a copy of a
# pinned page (commit 70e806e4e645), which scst_user relies on. Fedora's only
# 5.9.0 build defines RHEL_MAJOR, which SCST's backports treat as RHEL, so use
# Fedora 33's last 5.9 kernel. Keep the runtime kernel and build headers
# together; update kernel-5.9.SHA256SUMS as well.
KERNEL_BUILD=5.9.16-200.fc33
